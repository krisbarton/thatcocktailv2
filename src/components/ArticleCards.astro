---
/** A grid of article cards (image, title, one-line description), e.g. the guides on the ingredient hubs. */
import Icon from './Icon.astro';
import { media } from '../data/site';

interface Props {
  articles: { title: string; href: string; img: string; width: number; height: number; alt: string; desc: string }[];
  more?: string;
}
const { articles, more = 'Read the guide' } = Astro.props;
---
<ul class="articles">
  {articles.map((a) => (
    <li class="article-card">
      <div class="article-card__media">
        <img src={media(a.img)} width={a.width} height={a.height} alt={a.alt} loading="lazy" decoding="async">
      </div>
      <div class="article-card__body">
        <h3 class="article-card__title"><a href={a.href}>{a.title}</a></h3>
        <p class="article-card__desc">{a.desc}</p>
        <p class="article-card__more" aria-hidden="true">{more} <Icon name="arrow" class="arrow" /></p>
      </div>
    </li>
  ))}
</ul>

<style>
  .articles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
  .article-card{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:border-color .15s,box-shadow .15s}
  .article-card:hover{border-color:var(--pink);box-shadow:0 16px 32px -20px rgba(0,0,0,.45)}
  .article-card__media{aspect-ratio:5/3;background:#222;overflow:hidden}
  .article-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
  .article-card:hover .article-card__media img{transform:scale(1.04)}
  .article-card__body{display:flex;flex-direction:column;flex:1;padding:20px 22px 22px}
  .article-card__title{font:800 1.35rem/1.1 var(--font-display);color:#000}
  .article-card__title a{color:inherit;text-decoration:none}
  .article-card__title a::after{content:"";position:absolute;inset:0;border-radius:inherit}
  .article-card:hover .article-card__title a{text-decoration:underline;text-underline-offset:3px}
  .article-card__desc{margin-top:8px;color:var(--ink-soft)}
  .article-card__more{display:inline-flex;align-items:center;gap:6px;margin-top:auto;padding-top:16px;font-weight:700;color:var(--pink-ink)}
  .article-card:hover .article-card__more :global(.arrow){transform:translateX(3px)}
  @media (max-width:999px){
    .articles{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media (max-width:599px){
    .articles{grid-template-columns:minmax(0,1fr)}
  }
</style>
