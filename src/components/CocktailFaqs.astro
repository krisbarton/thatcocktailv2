---
import type { Faq } from '../lib/cocktail-faqs';

/** The FAQs under a recipe card. The page puts the same questions in its FAQPage schema. */
interface Props {
  title: string;
  faqs: Faq[];
}
const { title, faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faqs" id="faqs" aria-labelledby="faqs-title">
    <h2 class="r-h2" id="faqs-title">{title} FAQs</h2>
    <div class="faqs__list">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div class="faqs__answer"><p set:html={f.html} /></div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faqs{scroll-margin-top:24px}
  .faqs__list{margin-top:22px;border-top:2px solid #000}
  .faqs__list details{border-bottom:1px solid rgba(0,0,0,.16)}
  .faqs__list summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 0;cursor:pointer;list-style:none;font:700 1.15rem/1.25 var(--font-display);color:#000}
  .faqs__list summary::-webkit-details-marker{display:none}
  .faqs__list summary::after{content:"+";flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#fff;border:1px solid rgba(0,0,0,.2);color:var(--pink-ink);font:600 1.25rem/1 var(--font-body);transition:transform .2s ease}
  .faqs__list details[open] summary::after{transform:rotate(45deg)}
  .faqs__list summary:focus-visible{outline:3px solid var(--cyan);outline-offset:2px}
  .faqs__answer{padding:0 48px 20px 0;color:#333;max-width:72ch}
  .faqs__answer :global(a){font-weight:600}
  @media (max-width:699px){
    .faqs__answer{padding-right:0}
  }
  @media print{
    .faqs{display:none}
  }
</style>
