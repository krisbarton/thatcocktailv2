---
import Icon from './Icon.astro';
import { SITE } from '../data/site';

interface Props {
  /** Heading level for each card title. */
  as?: 'h2' | 'h3';
}
const { as: Heading = 'h3' } = Astro.props;
---
<ul class="contact-grid">
  <li class="contact-card">
    <span class="contact-card__icon"><Icon name="mail" /></span>
    <Heading class="contact-card__title">Email</Heading>
    <p class="contact-card__text">Questions, feedback or a recipe you’d like us to try.</p>
    <a class="contact-card__action" href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </li>
  <li class="contact-card">
    <span class="contact-card__icon"><Icon name="phone" /></span>
    <Heading class="contact-card__title">Phone</Heading>
    <p class="contact-card__text">Prefer to talk? Give us a call.</p>
    <a class="contact-card__action" href={SITE.phoneHref}>{SITE.phone}</a>
  </li>
  <li class="contact-card">
    <span class="contact-card__icon"><Icon name="chat" /></span>
    <Heading class="contact-card__title">Socials</Heading>
    <p class="contact-card__text">Say hello, or share the cocktails you’ve made.</p>
    <ul class="contact-card__social">
      <li><a href={SITE.social.facebook} rel="noopener" aria-label="ThatCocktail on Facebook"><Icon name="facebook" /></a></li>
      <li><a href={SITE.social.x} rel="noopener" aria-label="ThatCocktail on X (Twitter)"><Icon name="x" /></a></li>
      <li><a href={SITE.social.instagram} rel="noopener" aria-label="ThatCocktail on Instagram"><Icon name="instagram" /></a></li>
      <li><a href={SITE.social.youtube} rel="noopener" aria-label="ThatCocktail on YouTube"><Icon name="youtube" /></a></li>
    </ul>
  </li>
  <li class="contact-card">
    <span class="contact-card__icon"><Icon name="pin" /></span>
    <Heading class="contact-card__title">Send a letter</Heading>
    <address class="contact-card__address">
      {SITE.name}<br>
      {SITE.address.street}<br>
      {SITE.address.locality}, {SITE.address.postcode}<br>
      {SITE.address.country}
    </address>
  </li>
</ul>

<style>
  .contact-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .contact-card{display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:22px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);transition:border-color .15s,box-shadow .15s}
  .contact-card:hover{border-color:var(--pink);box-shadow:0 12px 26px -18px rgba(0,0,0,.45)}
  .contact-card__icon{display:grid;place-items:center;width:46px;height:46px;margin-bottom:6px;border-radius:14px;background:radial-gradient(60px at 50% -40%,var(--mag-hi) 0%,var(--mag-lo) 100%);color:#fff;box-shadow:0 10px 18px -12px rgba(117,11,62,.9)}
  .contact-card__icon :global(svg){width:22px;height:22px}
  .contact-card__title{font:800 1.35rem/1.1 var(--font-display);color:#000}
  .contact-card__text{font-size:.92rem;line-height:1.5;color:var(--ink-soft)}
  .contact-card__action{margin-top:auto;padding-top:6px;font-weight:700;color:var(--teal-ink);text-underline-offset:3px;overflow-wrap:anywhere}
  .contact-card__address{font-style:normal;font-size:.95rem;line-height:1.6;color:#333}
  .contact-card__social{display:flex;gap:10px;margin-top:auto;padding-top:6px}
  .contact-card__social a{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:var(--black);color:#fff;transition:background-color .15s}
  .contact-card__social a:hover{background:var(--pink-deep)}
  .contact-card__social :global(svg){width:20px;height:20px}

  @media (max-width:999px){
    .contact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media (max-width:499px){
    .contact-grid{grid-template-columns:minmax(0,1fr)}
  }
</style>
