  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={body} />
) : (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={body} />
)}
