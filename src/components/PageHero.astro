---
import Breadcrumbs from './Breadcrumbs.astro';

/**
 * The black neon bar that opens every inner page. Put the script word in the `script` slot,
 * e.g. <PageHero title="Contact"><Fragment slot="script">us</Fragment></PageHero>.
 * Anything in the `aside` slot sits to the right on wide screens. Pass `crumbs` (without Home)
 * for a breadcrumb trail above the copy.
 */
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  id?: string;
  centred?: boolean;
  compact?: boolean;
  /** Stack the aside above the copy on narrow screens (e.g. a profile photo). */
  asideFirst?: boolean;
  crumbs?: { name: string; href: string }[];
}
const { kicker, title, lead, id = 'page-title', centred = false, compact = false, asideFirst = false, crumbs } = Astro.props;
const hasAside = Astro.slots.has('aside');
const hasScript = Astro.slots.has('script');
---
<section class:list={['page-hero neon on-black', { 'page-hero--centred': centred, 'page-hero--compact': compact, 'page-hero--crumbs': crumbs }]} aria-labelledby={id}>
  {crumbs && <div class="wrap"><Breadcrumbs items={crumbs} /></div>}
  <div class:list={['wrap page-hero__grid', { 'page-hero__grid--aside': hasAside }]}>
    <div class="page-hero__copy">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1 class="neon-title page-hero__title" id={id}>
        {title}{hasScript && <>{' '}<span class="neon-script"><slot name="script" /></span></>}
      </h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <slot />
    </div>
    {hasAside && <div class:list={['page-hero__aside', { 'page-hero__aside--first': asideFirst }]}><slot name="aside" /></div>}
  </div>
</section>

<style>
  .page-hero{padding-block:clamp(44px,6vw,84px) clamp(48px,6.5vw,92px)}
  .page-hero--compact{padding-block:clamp(40px,5vw,64px)}
  /* Same spacing as the recipe pages’ breadcrumb. */
  .page-hero--crumbs{padding-top:clamp(24px,3.5vw,44px)}
  .page-hero--crumbs .page-hero__grid{margin-top:clamp(20px,3vw,36px)}
  .page-hero__grid{display:grid;grid-template-columns:minmax(0,1fr)}
  .page-hero__grid--aside{grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(36px,5vw,72px);align-items:center}
  .page-hero__copy{max-width:760px}
  .page-hero .kicker{margin-bottom:16px}
  .page-hero__title{font-size:clamp(2.4rem,5.2vw,4.1rem)}
  .page-hero--compact .page-hero__title{font-size:clamp(2.2rem,4.6vw,3.4rem)}
  .page-hero__lead{margin-top:22px;max-width:54ch;font-size:clamp(1.05rem,1.4vw,1.2rem);line-height:1.6;color:var(--on-black)}

  .page-hero--centred{text-align:center}
  .page-hero--centred .page-hero__copy{margin-inline:auto;display:flex;flex-direction:column;align-items:center}

  @media (max-width:899px){
    .page-hero__grid--aside{grid-template-columns:minmax(0,1fr)}
    .page-hero__aside--first{order:-1}
  }
</style>
