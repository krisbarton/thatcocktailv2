---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  lede?: string;
  more?: { label: string; href: string };
}
const { id, title, lede, more } = Astro.props;
---
<div class="section-head">
  <div>
    <h2 class="h2" id={id}>{title}</h2>
    {lede && <p class="section-head__lede">{lede}</p>}
  </div>
  {more && (
    <a class="more" href={more.href}>{more.label} <Icon name="arrow" class="arrow" /></a>
  )}
</div>
