---
/**
 * The free-guide email form, used by the signup section (GuideSignup) and the popup (GuideDialog).
 * Styled for a black background. `id` must be unique on the page.
 */
import { SITE } from '../data/site';

interface Props {
  id: string;
}
const { id } = Astro.props;
const inputId = `${id}-email`;
---
<form class="subscribe subscribe-form" method="post" accept-charset="UTF-8" data-endpoint={SITE.subscribeEndpoint} novalidate>
  <label for={inputId}>Your email address</label>
  <div class="subscribe__row">
    <input id={inputId} name="email" type="email" autocomplete="email" required placeholder="you@example.com">
    <button class="btn btn--green" type="submit">Download the guide</button>
  </div>
  <p class="subscribe__error" role="alert" hidden></p>
  <p class="subscribe__note">Don’t worry, we won’t spam you. Read our <a href="/privacy-policy/">privacy policy</a>.</p>
</form>

<style>
  .subscribe{margin-top:26px;max-width:580px}
  .subscribe label{display:block;margin-bottom:8px;font-weight:700}
  .subscribe__row{display:flex;flex-wrap:wrap;gap:14px}
  .subscribe input{flex:1 1 240px;min-width:0;height:54px;padding-inline:16px;border:2px solid #fff;border-radius:14px;background:#fff;color:var(--ink);font-size:1rem}
  .subscribe input:focus{outline:none;border-color:var(--cyan);box-shadow:0 0 0 4px rgba(81,229,255,.35)}
  .subscribe input[aria-invalid="true"]{border-color:var(--pink)}
  .subscribe .btn{height:54px}
  .subscribe__error{margin-top:12px;padding:10px 14px;border-radius:12px;background:rgba(236,54,141,.14);border:1px solid var(--pink);color:#fff;font-size:.92rem}
  .subscribe__note{margin-top:14px;font-size:.88rem;color:var(--on-black-soft)}
  .subscribe__note a{color:var(--cyan)}
</style>

<script>
  // Same flow as the WordPress theme: post the email to the subscriber API, then send people to /almost-done/.
  document.querySelectorAll<HTMLFormElement>('form.subscribe-form').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const error = form.querySelector<HTMLElement>('.subscribe__error')!;
    const label = button.textContent;

    const showError = (message: string) => {
      error.textContent = message;
      error.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      input.removeAttribute('aria-invalid');

      if (!input.checkValidity()) {
        input.setAttribute('aria-invalid', 'true');
        showError('Please enter a valid email address, e.g. you@example.com.');
        input.focus();
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const response = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value.trim() }),
        });
        const data = await response.json();
        if (data.ok) {
          window.location.href = '/almost-done/';
          return;
        }
        throw new Error('Subscribe failed');
      } catch {
        showError('Sorry, we couldn’t sign you up just now. Please try again in a minute.');
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>
