---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProofBar from '../components/ProofBar.astro';
import Icon from '../components/Icon.astro';
import ContactMethods from '../components/ContactMethods.astro';
import GuideSignup from '../components/GuideSignup.astro';
import { SITE, kris, media } from '../data/site';
import { organization, website, krisPerson, webPage, breadcrumbs, ids } from '../data/schema';

const path = '/about/';
const title = 'About ThatCocktail | Quick & Easy Cocktail Recipes Since 2019';
const description = 'ThatCocktail shares quick and easy cocktail recipes anybody can make at home, built on 20+ years of making (and drinking) cocktails. Meet founder Kris Barton.';

const promises = [
  {
    icon: 'clock',
    title: 'Quick and easy',
    text: 'Bar-quality cocktails that anybody can make, with exact measures in ml and oz and just a few simple steps.',
  },
  {
    icon: 'scroll',
    title: 'The story behind the drink',
    text: 'Interesting background on every cocktail, so you know where it came from as well as how to make it.',
  },
  {
    icon: 'bulb',
    title: 'Insider tips and tricks',
    text: 'The little things that take your cocktail-making game to a whole other level.',
  },
] as const;

const schema = [
  organization,
  website,
  krisPerson,
  webPage({
    path,
    type: 'AboutPage',
    name: title,
    description,
    extra: { about: { '@id': ids.org }, breadcrumb: { '@id': `${SITE.url}${path}#breadcrumb` } },
  }),
  breadcrumbs(path, [{ name: 'About us', path }]),
];
---
<BaseLayout title={title} description={description} schema={schema}>
  <PageHero kicker="About ThatCocktail" title="We simplify making great"
    lead="Making cocktails can be time-consuming and tricky, but it doesn’t have to be. We offer quick and easy cocktail recipes that anybody can make. Our 20+ years of making (and more importantly drinking!) cocktails will save you time, effort and money.">
    <Fragment slot="script">cocktails</Fragment>
    <div class="about-hero__actions">
      <a class="btn btn--green" href="/cocktails/"><Icon name="cocktail" />Browse the recipes</a>
      <a class="btn btn--ghost" href="#founder-title">Meet the founder</a>
    </div>
    <img slot="aside" class="about-hero__img" src={media('/wp-content/uploads/2023/11/cocktails-by-sprirt.png')}
         width="500" height="500" alt="A creamy highball, a blue cocktail, copper mugs of Moscow Mule and an orange martini on a cyan and pink background" decoding="async">
  </PageHero>

  <ProofBar />

  <section class="section" aria-labelledby="what-title">
    <div class="wrap what">
      <div class="what__intro">
        <p class="kicker">What we can do for you</p>
        <h2 class="h2" id="what-title">Great cocktails don’t have to be complicated</h2>
        <p class="what__text">Making great cocktails doesn’t have to be complicated, time-consuming, or even expensive. At ThatCocktail, we’ll teach you how to make bar-quality, quick and easy cocktails.</p>
        <p class="what__text">While we’re at it, we’ll throw in interesting background information on the cocktails, as well as insider tips and tricks to help you take your cocktail-making game to a whole other level.</p>
      </div>
      <ul class="promises">
        {promises.map((p) => (
          <li class="promise">
            <span class="promise__icon"><Icon name={p.icon} /></span>
            <h3 class="promise__title">{p.title}</h3>
            <p class="promise__text">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--mist founder" aria-labelledby="founder-title">
    <div class="wrap founder__grid">
      <img class="portrait"
           src={media(kris.photo)}
           srcset={`${media(kris.photo)} 300w, ${media(kris.photoLarge)} 1080w`}
           sizes="(min-width: 700px) 280px, 200px" width="300" height="300"
           alt="Kris Barton, founder of ThatCocktail, enjoying a cocktail" loading="lazy" decoding="async">
      <div>
        <p class="kicker">Meet the founder</p>
        <h2 class="h2 founder__title" id="founder-title">Kris Barton</h2>
        <p class="founder__text">Kris Barton has been making (and sometimes creating) cocktails for over 20 years.</p>
        <p class="founder__text">In 2019, he launched ThatCocktail.com to share simplified, quick and easy cocktail recipes. The goal was to provide these recipes with a little extra detail about the drink, the ingredients, and the equipment used to make bar-quality cocktails at home.</p>
        <ul class="facts">
          {kris.facts.map((f) => <li>{f}</li>)}
        </ul>
        <p class="founder__links">
          <a class="more" href={kris.url}>Read Kris’s author profile <Icon name="arrow" class="arrow" /></a>
          <a class="more" href={kris.favourite.href}>Make his Moscow Mule <Icon name="arrow" class="arrow" /></a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Contact us</p>
          <h2 class="h2" id="contact-title">Got questions? Wanna chat? Let’s do it!</h2>
        </div>
        <a class="more" href="/contact-us/">All the ways to get in touch <Icon name="arrow" class="arrow" /></a>
      </div>
      <ContactMethods />
    </div>
  </section>

  <GuideSignup />
</BaseLayout>

<style>
  .about-hero__actions{margin-top:30px;display:flex;flex-wrap:wrap;gap:14px 16px}
  .about-hero__img{width:100%;max-width:440px;margin-left:auto;aspect-ratio:1;object-fit:cover;border-radius:24px;border:2px solid var(--cyan);box-shadow:0 0 0 6px rgba(81,229,255,.12),0 30px 60px -30px rgba(81,229,255,.55)}

  .what{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(32px,6vw,80px);align-items:center}
  .what .kicker,.founder .kicker,.section-head .kicker{margin-bottom:12px}
  .what__text{margin-top:16px;max-width:56ch;font-size:1.05rem;color:#333}

  .promises{display:grid;gap:14px}
  .promise{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:16px;align-items:start;padding:20px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;transition:border-color .15s,box-shadow .15s}
  .promise:hover{border-color:var(--pink);box-shadow:0 12px 26px -18px rgba(0,0,0,.45)}
  .promise__icon{grid-row:span 2;display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:radial-gradient(60px at 50% -40%,var(--mag-hi) 0%,var(--mag-lo) 100%);color:#fff;box-shadow:0 10px 18px -12px rgba(117,11,62,.9)}
  .promise__icon :global(svg){width:24px;height:24px}
  .promise__title{font:800 1.3rem/1.15 var(--font-display);color:#000}
  .promise__text{margin-top:4px;font-size:.95rem;color:var(--ink-soft)}

  .founder__grid{display:grid;grid-template-columns:minmax(0,280px) minmax(0,1fr);gap:clamp(32px,6vw,80px);align-items:center}
  .founder__title{margin-bottom:4px}
  .founder__text{margin-top:14px;max-width:60ch;font-size:1.05rem;color:#333}
  .founder .facts{margin-top:18px}
  .founder__links{margin-top:20px;display:flex;flex-wrap:wrap;gap:10px 28px}

  @media (max-width:899px){
    .what{grid-template-columns:minmax(0,1fr)}
    .about-hero__img{margin-left:0;max-width:360px}
  }
  @media (max-width:699px){
    .founder__grid{grid-template-columns:minmax(0,1fr)}
  }
  @media (max-width:599px){
    .about-hero__actions .btn{flex:1 1 100%}
  }
</style>
