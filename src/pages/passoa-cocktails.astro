    <img class="pick__img" src={media('/wp-content/uploads/2020/11/cocktail-set-autumndeer.png')} width="300" height="280" alt="Autumndeer cocktail shaker set with jigger, strainer and bar spoon" loading="lazy" decoding="async">
    <div>
      <p class="pick__name">Autumndeer Cocktail Shaker Set</p>
