---
import CollectionLayout from '../layouts/CollectionLayout.astro';

const path = '/spring-cocktail-recipes/';
const seasons = [
  { name: 'Winter cocktails', href: '/winter-cocktail-recipes/' },
  { name: 'Summer cocktails', href: '/summer-cocktail-recipes/' },
  { name: 'Autumn cocktails', href: '/autumn-cocktail-recipes/' },
];
---
<CollectionLayout
  path={path}
  collection="Spring"
  heading="Spring"
  title="Spring Cocktails: Our Full List of Spring Cocktail Recipes | ThatCocktail"
  description="Our full list of spring cocktail recipes, from the Bee’s Knees to the Aviation, with measures in ml and oz."
  lead="A change of weather calls for a change of cocktail. Here’s our full list of spring cocktail recipes."
  listLede="Every ThatCocktail recipe for spring, newest first."
  parent={[
    { name: 'Types of cocktails', href: '/types-of-cocktails/' },
    { name: 'Seasonal cocktails', href: '/seasonal-cocktails/' },
  ]}
  siblings={{
    title: 'Cocktails for other seasons',
    links: seasons,
    more: { label: 'All seasonal cocktails', href: '/seasonal-cocktails/' },
  }}
/>
