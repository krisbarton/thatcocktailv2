  return toCard(c);
});
const withBlueCuracao = cocktails.filter((c) => usesIngredient(c, /blue cura[cç]ao/)).length;

// Bols is the same pick as /alcohol-recommendations/, so it keeps the US link.
const brands: Product[] = [
