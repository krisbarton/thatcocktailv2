const cocktails = await getCocktails();
const bySlug = new Map(cocktails.map((c) => [c.id, c]));
const card = (slug: string) => {
  const c = bySlug.get(slug);
  if (!c) throw new Error(`what-is-campari: no recipe called ${slug}`);
  return toCard(c);
};
// Only a handful of recipes use Campari, so the closing link goes to the bitter cocktails instead.
const bitter = cocktails.filter((c) => c.data.collections.some((t) => t.label === 'Bitter')).length;

// Same Campari as /alcohol-recommendations/.
const campari = alcoholPick('campari');

const toc = [
  { href: '#the-history-of-campari', label: 'The history of Campari' },
  { href: '#what-is-campari-made-from', label: 'What is Campari made from?' },
  { href: '#what-does-campari-taste-like', label: 'What does Campari taste like?' },
  { href: '#how-do-you-drink-campari', label: 'How do you drink Campari?' },
  { href: '#what-cocktails-can-you-make-with-campari', label: 'Cocktails with Campari' },
  { href: '#summary', label: 'Summary' },
];

const related = ['/what-is-triple-sec/', '/what-is-blue-curacao/', '/what-is-peach-schnapps/'].map((href) => ingredientGuides.find((g) => g.href === href)!);
