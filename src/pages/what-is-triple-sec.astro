import { kit } from '../data/products';
import { ingredientGuides } from '../data/recipes';
import { getCocktails, toCard, usesIngredient } from '../lib/cocktails';

const cocktails = await getCocktails();
const bySlug = new Map(cocktails.map((c) => [c.id, c]));
const featured = ['kamikaze', 'long-island-iced-tea', 'cosmopolitan', 'appletini'].map((slug) => {
  const c = bySlug.get(slug);
  if (!c) throw new Error(`what-is-triple-sec: no recipe called ${slug}`);
  return toCard(c);
});
// The search finds Cointreau recipes for "triple sec" too (see `kinds` in src/lib/cocktails.ts).
const withTripleSec = cocktails.filter((c) => usesIngredient(c, /triple sec|cointreau/)).length;

// Same Cointreau as /alcohol-recommendations/, so it keeps the US link.
const cointreau = alcoholPick('triple-sec');

const toc = [
  { href: '#what-does-triple-sec-mean', label: 'What does triple sec mean?' },
  { href: '#the-history-of-triple-sec', label: 'The history of triple sec' },
  { href: '#what-is-triple-sec-made-of', label: 'What is triple sec made of?' },
  { href: '#how-is-triple-sec-made', label: 'How is triple sec made?' },
  { href: '#how-much-alcohol-is-in-triple-sec', label: 'How much alcohol is in triple sec?' },
  { href: '#cocktails-with-triple-sec', label: 'Cocktails with triple sec' },
  { href: '#summary', label: 'Summary' },
];

const related = ['/what-is-blue-curacao/', '/what-is-campari/', '/what-is-peach-schnapps/'].map((href) => ingredientGuides.find((g) => g.href === href)!);
const amazon = { target: '_blank', rel: 'sponsored noopener' };
